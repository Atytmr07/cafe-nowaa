rules_version = '2';

// Dish photography is public; uploads are staff-only and capped so a
// stolen session cannot fill the bucket with arbitrary files.
service firebase.storage {
  match /b/{bucket}/o {

    match /menu/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
