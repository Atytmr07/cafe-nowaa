rules_version = '2';

// The menu is public reading matter; only signed-in staff may change it.
// Create admin accounts in Firebase Console → Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anything not named above stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
